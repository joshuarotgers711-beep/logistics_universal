{
  "title": "RabbitMQ DLQ & Consumers",
  "templating": {
    "list": [
      {
        "name": "dlq_queue",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "refresh": 2,
        "query": "label_values(rabbitmq_queue_messages_ready, queue)",
        "regex": "/(shipments|labels|pricing|tracking)\\.dlq/",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {"type":"row","title":"Backlog & Consumers","gridPos":{"x":0,"y":0,"w":24,"h":1}},
    {
      "type": "stat",
      "title": "DLQ total messages (ready)",
      "gridPos": {"x": 0, "y": 1, "w": 12, "h": 4},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
         "expr": "sum(rabbitmq_queue_messages_ready{queue=~\"$dlq_queue\"})", "instant": true}
      ]
    },
    {
      "type": "stat",
      "title": "Consumers on DLQs",
      "gridPos": {"x": 12, "y": 1, "w": 12, "h": 4},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
         "expr": "sum(rabbitmq_queue_consumers{queue=~\"$dlq_queue\"})", "instant": true}
      ]
    },
    {
      "type": "table",
      "title": "DLQ per-queue status",
      "gridPos": {"x": 0, "y": 5, "w": 24, "h": 10},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
         "expr": "rabbitmq_queue_messages_ready{queue=~\"$dlq_queue\"}", "legendFormat": "{{queue}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "DLQ messages ready (rate)",
      "gridPos": {"x": 0, "y": 15, "w": 24, "h": 8},
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"},
         "expr": "sum by (queue) (rate(rabbitmq_queue_messages_ready{queue=~\"$dlq_queue\"}[5m]))", "legendFormat": "{{queue}}"}
      ]
    },
    {"type":"row","title":"DLQ Ops (dlqctl)","gridPos":{"x":0,"y":23,"w":24,"h":1}},
    {"type":"stat","title":"Replayed/min","gridPos":{"x":0,"y":24,"w":12,"h":4},
     "targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},
                  "expr":"sum(rate(dlqctl_replayed_total[5m]))","instant":true}]},
    {"type":"stat","title":"Quarantined/min","gridPos":{"x":12,"y":24,"w":12,"h":4},
     "targets":[{"datasource":{"type":"prometheus","uid":"prometheus"},
                  "expr":"sum(rate(dlqctl_quarantined_total[5m]))","instant":true}]}
  ],
  "time": {"from": "now-6h", "to": "now"},
  "schemaVersion": 39,
  "version": 1
}

