{
  "title": "Service Overview",
  "uid": "service-overview",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Request Rate (req/s) by Service",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        {
          "expr": "sum by (service_name) (rate(http_server_requests_total[5m]))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency P50/P90/P95/P99 (ms) by Service",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (service_name, le) (rate(http_server_duration_milliseconds_bucket[5m])))",
          "legendFormat": "P50 {{service_name}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (service_name, le) (rate(http_server_duration_milliseconds_bucket[5m])))",
          "legendFormat": "P90 {{service_name}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(http_server_duration_milliseconds_bucket[5m])))",
          "legendFormat": "P95 {{service_name}}",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (service_name, le) (rate(http_server_duration_milliseconds_bucket[5m])))",
          "legendFormat": "P99 {{service_name}}",
          "refId": "D"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rate (%) by Service",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        {
          "expr": "100 * (sum by (service_name) (rate(http_server_requests_total{http_status_code=~\"5..\"}[5m])) / clamp_min(sum by (service_name) (rate(http_server_requests_total[5m])), 1e-9))",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dependency Latency P95 (ms) by Service",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(http_client_duration_milliseconds_bucket[5m])))",
          "legendFormat": "P95 {{service_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Correlated Logs (filter by trace_id)",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true },
      "targets": [
        {
          "expr": "{container=~\"lmp-.*\"} |~ \"trace_id=\"",
          "refId": "A"
        }
      ]
    }
  ]
}

